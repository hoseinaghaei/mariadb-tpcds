# ---------------------------------------------------------------------------
#  TPC-DS configuration
#
#  Performance settings match tpcds-run-tool/setup-server/setup-mariadb-current.sh,
#  whose my.cnf contains exactly ONE performance line: innodb_buffer_pool_size=8G.
#  Everything else in that file is plumbing (datadir, socket, port, server-id).
#
#  Observability settings below are ours and are deliberately kept.
#
#  Revert everything: rm this file and `brew services restart mariadb`.
# ---------------------------------------------------------------------------
[mariadb]

# --- Performance: matches the reference repo -------------------------------
innodb_buffer_pool_size         = 8G

# --- Guard (not in the repo) -----------------------------------------------
# Query 72 previously consumed 21 and 29 minutes without completing. This
# bounds any single statement so a run cannot stall indefinitely.
max_statement_time              = 300

# --- Usage statistics ------------------------------------------------------
userstat                        = 1

# --- Performance Schema ----------------------------------------------------
performance_schema              = ON
performance-schema-consumer-events-statements-history      = ON
performance-schema-consumer-events-statements-history-long = ON

# --- Slow query log --------------------------------------------------------
slow_query_log                  = 1
slow_query_log_file             = /opt/homebrew/var/mysql/slow.log
log_output                      = FILE
long_query_time                 = 0.5
log_slow_verbosity              = query_plan,explain,innodb
log_queries_not_using_indexes   = 1
min_examined_row_limit          = 1000
log_slow_admin_statements       = 1

# --- InnoDB counters -------------------------------------------------------
innodb_monitor_enable           = all
